# Copy to Render static site / build env (or .env.production locally).
# Required for production API + WebSocket (wss is derived from https automatically).
VITE_API_URL=https://skyshield-backend.onrender.com/api

# Optional — only if WebSockets use a different host than the API.
# Must be a full origin with hostname, e.g. wss://skyshield-backend.onrender.com
# Do NOT set to bare "wss://" — that breaks meetings and simulations.
# VITE_WS_URL=wss://skyshield-backend.onrender.com
